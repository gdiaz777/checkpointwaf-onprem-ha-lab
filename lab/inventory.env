# Lab inventory: single source of truth for names, IPs and ports.
# Sourced by every lab/ script. No secrets here (secrets live in .env).

GW_WAF=10.90.20.1          # host, inside network (waflab)
GW_OUT=10.90.30.1          # host, outside network (wafout) = "public" side of the firewall
VIP=10.90.20.100           # keepalived floating IP; the firewall DNATs to it

NODE1_IP=10.90.20.11
NODE2_IP=10.90.20.12
NODE3_IP=10.90.20.13
BACKEND1_IP=10.90.20.5     # app1
BACKEND2_IP=10.90.20.6     # app2
CLIENT_IP=10.90.30.10

APP1_FQDN=app1.waflab.example
APP2_FQDN=app2.waflab.example

# Port the agent's NGINX listens on, on each node's OWN IP. It must be the port in the
# Infinity Portal asset URL (443): the agent only applies an asset when host AND listening
# port match. HAProxy listens on the VIP (and 127.0.0.1), so both can use 443.
AGENT_PORT=443

# Interface that carries the VIP and VRRP on the WAF nodes (vSphere vmxnet3: usually ens192).
VRRP_IFACE=enp1s0

# WAF nodes that are part of the cluster, as name:ip. Adding a node = adding it here
# and re-rendering HAProxy/keepalived on every node (chapter 10).
WAF_NODES="waf-node1:10.90.20.11 waf-node2:10.90.20.12 waf-node3:10.90.20.13"
