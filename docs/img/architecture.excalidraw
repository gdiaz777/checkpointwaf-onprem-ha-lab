  {
   "id": "2nZ20D2dsClA3Amsjd6v",
   "type": "text",
   "x": 1060.0,
   "y": 152.0,
   "width": 268.8,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1971c2",
