  },
  {
   "id": "gYMT8VtSTtGr3H1fOFyp",
   "type": "text",
   "x": 1060.0,
   "y": 152.0,
   "width": 268.8,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1681147779,
   "version": 1,
   "versionNonce": 1547678974,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793930162139,
   "link": null,
   "locked": false,
   "text": "All agents: outbound HTTPS to the portal\n(same profile & policy on every node)",
   "originalText": "All agents: outbound HTTPS to the portal\n(same profile & policy on every node)",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "09vEhWLr7Mt2O4zfTOAe",
   "type": "rectangle",
   "x": 1380.0,
   "y": 75.0,
   "width": 330.0,
   "height": 230.0,
   "angle": 0,
   "strokeColor": "#5f6368",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "dashed",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1701135404,
   "version": 1,
   "versionNonce": 649139164,
   "isDeleted": false,
