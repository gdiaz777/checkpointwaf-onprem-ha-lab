  {
   "id": "tgJnlMbLSeHEkiNH1HaR",
   "type": "text",
   "x": 1385.0,
   "y": 544.0,
   "width": 371.28000000000003,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
