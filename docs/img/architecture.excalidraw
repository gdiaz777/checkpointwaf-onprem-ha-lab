   "locked": false
  },
  {
   "id": "u0GTRT7rM6S905tkOu7v",
   "type": "text",
   "x": 1385.0,
   "y": 324.0,
   "width": 342.16,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1347182639,
   "version": 1,
   "versionNonce": 1530402293,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793930162139,
   "link": null,
   "locked": false,
   "text": "Key settings\nHAProxy:\n  check inter 3s fall 3 rise 2 \u00b7 slowstart 30s\n  timeout connect 1s \u00b7 retries 3 \u00b7 redispatch 1\n  observe layer7 \u00b7 on-error fastinter\nkeepalived:\n  advert_int 1 \u00b7 unicast_peer \u00b7 nopreempt\n  chk_haproxy WITHOUT weight (\u2192 FAULT)\nSystem:\n  net.ipv4.ip_nonlocal_bind=1",
   "originalText": "Key settings\nHAProxy:\n  check inter 3s fall 3 rise 2 \u00b7 slowstart 30s\n  timeout connect 1s \u00b7 retries 3 \u00b7 redispatch 1\n  observe layer7 \u00b7 on-error fastinter\nkeepalived:\n  advert_int 1 \u00b7 unicast_peer \u00b7 nopreempt\n  chk_haproxy WITHOUT weight (\u2192 FAULT)\nSystem:\n  net.ipv4.ip_nonlocal_bind=1",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
