   "isDeleted": false,
   "boundElements": [],
   "updated": 1793932307429,
   "link": null,
   "locked": false,
   "text": "All agents: outbound HTTPS to the portal\n(same profile & policy on every node)",
   "originalText": "All agents: outbound HTTPS to the portal\n(same profile & policy on every node)",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "XgT3EncJh7d3niyogNXP",
   "type": "rectangle",
   "x": 1380.0,
   "y": 75.0,
   "width": 330.0,
   "height": 230.0,
   "angle": 0,
   "strokeColor": "#5f6368",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "dashed",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
