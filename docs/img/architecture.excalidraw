   "seed": 1484865028,
   "version": 1,
   "versionNonce": 714240486,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793930162139,
   "link": null,
   "locked": false,
   "text": "Scale-out (node3, node4\u2026)  \u2014 measured: 0 errors\n\u2022 Build VM, install agent with the same token\n\u2022 Add it to WAF_NODES\n\u2022 Reload keepalived, then HAProxy on existing nodes\n\u2022 Start HAProxy + keepalived on the new node LAST\n\u2022 No change on the firewall or the portal",
   "originalText": "Scale-out (node3, node4\u2026)  \u2014 measured: 0 errors\n\u2022 Build VM, install agent with the same token\n\u2022 Add it to WAF_NODES\n\u2022 Reload keepalived, then HAProxy on existing nodes\n\u2022 Start HAProxy + keepalived on the new node LAST\n\u2022 No change on the firewall or the portal",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
