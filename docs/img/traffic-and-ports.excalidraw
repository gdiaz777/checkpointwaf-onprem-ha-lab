   "y": 520.0,
   "width": 540.0,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#5f6368",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "dashed",
