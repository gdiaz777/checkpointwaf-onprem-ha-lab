   "text": "Infinity Portal\npolicy \u00b7 logs (outbound HTTPS\nfrom every agent)",
   "originalText": "Infinity Portal\npolicy \u00b7 logs (outbound HTTPS\nfrom every agent)",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "center",
