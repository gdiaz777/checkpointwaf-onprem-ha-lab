  },
  {
   "id": "tCYgu8x5R4DTi8YbA3nB",
   "type": "text",
   "x": 25.0,
   "y": 524.0,
   "width": 371.28000000000003,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1771941435,
   "version": 1,
   "versionNonce": 804484431,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793932307461,
   "link": null,
   "locked": false,
   "text": "Client IP end to end\n\u2022 Firewall: DNAT only (keeps 10.90.30.10 as source)\n\u2022 HAProxy: drops client XFF, sets XFF = 10.90.30.10\n\u2022 Asset source identity = X-Forwarded-For\n\u2022 Portal: Source IP = HAProxy node,\n  Source Identifier = 10.90.30.10 (the client)",
   "originalText": "Client IP end to end\n\u2022 Firewall: DNAT only (keeps 10.90.30.10 as source)\n\u2022 HAProxy: drops client XFF, sets XFF = 10.90.30.10\n\u2022 Asset source identity = X-Forwarded-For\n\u2022 Portal: Source IP = HAProxy node,\n  Source Identifier = 10.90.30.10 (the client)",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "vrDebZNFHqhlPk5Vsqcx",
   "type": "rectangle",
   "x": 490.0,
   "y": 520.0,
   "width": 520.0,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#5f6368",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "dashed",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1178478016,
   "version": 1,
   "versionNonce": 1710531434,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793932307461,
   "link": null,
   "locked": false
  },
  {
   "id": "NPAkDDjfxXvio16XV7x4",
   "type": "text",
   "x": 495.0,
   "y": 524.0,
   "width": 451.36000000000007,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2064600491,
   "version": 1,
   "versionNonce": 437415337,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1793932307461,
   "link": null,
   "locked": false,
   "text": "Why port 443 twice on the same VM?\n\u2022 HAProxy binds the VIP:443 (ip_nonlocal_bind=1 on every node)\n\u2022 NGINX binds the node's own IP:443\n\u2022 The agent applies an asset only if Host AND the listening\n  port match the asset URL (https://app\u2026 = 443).\n  On 8443 nothing was inspected and nothing was logged.",
   "originalText": "Why port 443 twice on the same VM?\n\u2022 HAProxy binds the VIP:443 (ip_nonlocal_bind=1 on every node)\n\u2022 NGINX binds the node's own IP:443\n\u2022 The agent applies an asset only if Host AND the listening\n  port match the asset URL (https://app\u2026 = 443).\n  On 8443 nothing was inspected and nothing was logged.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "UHIT4QhGeStJhTwHAKcU",
   "type": "rectangle",
   "x": 1030.0,
   "y": 520.0,
   "width": 540.0,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#5f6368",
   "backgroundColor": "#ffffff",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "dashed",
   "roughness": 0,
   "opacity": 100,
