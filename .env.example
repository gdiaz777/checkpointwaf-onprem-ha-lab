# Copy to .env (git-ignored) and fill in. Never commit .env.
# Agent registration token from the Infinity Portal profile (Profile > Authentication).
CGWAF_TOKEN="<your-token>"
# SSH key used to log in to the lab VMs as user "lab".
LAB_SSH_KEY="~/.ssh/waflab_ed25519"
# Password for the HAProxy stats page (bound to each node's own IP, port 8404).
HAPROXY_STATS_PASS="<choose-a-password>"
