# NGINX reverse proxy on each WAF node. The CloudGuard WAF agent attaches to
# this NGINX (load_module ngx_cp_attachment_module.so, added by the installer)
# and inspects everything it proxies.
#
# It listens on the node's OWN IP, port __AGENT_PORT__ (443). The agent applies an asset only
# when host AND listening port match the asset URL in the portal (https://appN… = 443).
# HAProxy owns 443 on the VIP and on 127.0.0.1, so there is no conflict.
upstream app1_backend { server __BACKEND1_IP__:443; keepalive 16; }
upstream app2_backend { server __BACKEND2_IP__:443; keepalive 16; }

map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

server {
    listen __NODE_IP__:__AGENT_PORT__ ssl;
    server_name __APP1_FQDN__;
    ssl_certificate     /etc/nginx/tls/__APP1_FQDN__.crt;
    ssl_certificate_key /etc/nginx/tls/__APP1_FQDN__.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass https://app1_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_ssl_name backend1.waflab.internal;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/nginx/tls/ca.crt;
    }
}

server {
    listen __NODE_IP__:__AGENT_PORT__ ssl;
    server_name __APP2_FQDN__;
    ssl_certificate     /etc/nginx/tls/__APP2_FQDN__.crt;
    ssl_certificate_key /etc/nginx/tls/__APP2_FQDN__.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass https://app2_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_ssl_name backend2.waflab.internal;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/nginx/tls/ca.crt;
    }
}
