# Lab backend: answers every request with a small JSON document that shows
# which app/backend answered, who connected (= the WAF agent that forwarded
# the request) and the X-Forwarded-For chain.
server {
    listen 443 ssl;
    listen 80;
    server_name _;
    ssl_certificate     /etc/nginx/tls/backend.crt;
    ssl_certificate_key /etc/nginx/tls/backend.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz {
        default_type text/plain;
        return 200 "ok";
    }
    location / {
        default_type application/json;
        return 200 '{"app":"__APP__","backend":"$hostname","client_addr":"$remote_addr","xff":"$http_x_forwarded_for","host":"$host","uri":"$request_uri"}\n';
    }
}
